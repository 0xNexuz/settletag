{
  "name": "settletag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.js",
    "test": "npm run compile && node --test test/*.test.js",
    "dev": "npm run compile && vite --host 127.0.0.1",
    "build": "npm run compile && vite build",
    "wallet:create": "node scripts/create-local-test-wallet.js",
    "wallet:check": "node scripts/verify-local-test-wallet.js",
    "wallet:payer:create": "node scripts/create-local-test-wallet.js payer",
    "wallet:payer:check": "node scripts/verify-local-test-wallet.js payer",
    "deploy:testnet": "npm run compile && node scripts/deploy.js",
    "deploy:saved:testnet": "npm run compile && node --use-system-ca scripts/deploy-saved-test-wallet.js",
    "smoke:testnet": "npm run compile && node --use-system-ca scripts/smoke-testnet.js",
    "borrow:preview": "node --use-system-ca scripts/borrow-test-musd.js",
    "borrow:testnet": "node --use-system-ca scripts/borrow-test-musd.js --execute",
    "payer:fund": "node --use-system-ca scripts/fund-test-payer.js",
    "payer:pay": "npm run compile && node --use-system-ca scripts/pay-test-invoice.js"
  },
  "dependencies": {
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "solc": "0.8.28",
    "vite": "^7.1.0"
  }
}
