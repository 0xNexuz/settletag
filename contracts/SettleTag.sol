pragma solidity ^0.8.28;

/// @notice One-time MUSD invoices with direct merchant settlement and onchain receipts.
/// @dev No tokens are held by this contract. Merchants create invoices; payers approve MUSD first.
contract SettleTag {
    enum Status { Missing, Open, Paid, Cancelled }

    struct Invoice {
        address merchant;
        uint128 amount;
        uint64 deadline;
        Status status;
        address payer;
    }

    address public immutable musd;
    mapping(bytes32 => Invoice) public invoices;

    event InvoiceCreated(bytes32 indexed id, address indexed merchant, uint256 amount, uint64 deadline);
    event InvoicePaid(bytes32 indexed id, address indexed merchant, address indexed payer, uint256 amount);
    event InvoiceCancelled(bytes32 indexed id, address indexed merchant);

    error InvalidToken();
    error InvalidInvoice();
    error InvoiceExists();
    error NotMerchant();
    error NotOpen();
    error Expired();
    error TransferFailed();

    constructor(address musd_) {
        if (musd_ == address(0) || musd_.code.length == 0) revert InvalidToken();
        musd = musd_;
    }

    /// @param id Random 32-byte reference generated by the merchant's client.
    /// @param amount Exact MUSD amount in token base units.
    function createInvoice(bytes32 id, uint128 amount, uint64 deadline) external {
        if (id == bytes32(0) || amount == 0 || deadline <= block.timestamp) revert InvalidInvoice();
        if (invoices[id].status != Status.Missing) revert InvoiceExists();
        invoices[id] = Invoice(msg.sender, amount, deadline, Status.Open, address(0));
        emit InvoiceCreated(id, msg.sender, amount, deadline);
    }

    function cancelInvoice(bytes32 id) external {
        Invoice storage invoice = invoices[id];
        if (invoice.merchant != msg.sender) revert NotMerchant();
        if (invoice.status != Status.Open) revert NotOpen();
        invoice.status = Status.Cancelled;
        emit InvoiceCancelled(id, msg.sender);
    }

    function payInvoice(bytes32 id) external {
        Invoice storage invoice = invoices[id];
        if (invoice.status != Status.Open) revert NotOpen();
        if (block.timestamp > invoice.deadline) revert Expired();
        invoice.status = Status.Paid;
        invoice.payer = msg.sender;

        // Handle standard ERC-20 return values and tokens that return no value.
        (bool ok, bytes memory data) = musd.call(
            abi.encodeWithSelector(0x23b872dd, msg.sender, invoice.merchant, uint256(invoice.amount))
        );
        if (!ok || (data.length != 0 && (data.length != 32 || !abi.decode(data, (bool))))) {
            revert TransferFailed();
        }
        emit InvoicePaid(id, invoice.merchant, msg.sender, invoice.amount);
    }
}
